{
  "name": "hermes-town",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve:live": "node server/serve-live.mjs",
    "install:plugin": "node scripts/install-hermes-town-plugin.mjs",
    "typecheck": "tsc -b",
    "test:contracts": "python3 tests/verify-plugin-privacy.py && node tests/verify-server-contract.mjs && node tests/verify-cron-seed.mjs",
    "test": "npm run test:contracts && npm run build && npm run verify:characters && npm run verify:world",
    "verify:characters": "node scripts/verify-characters.mjs && node scripts/verify-motion.mjs",
    "verify:world": "node scripts/verify-world.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
